{
    // Configurations for debugging
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch DuckDB",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/debug/duckdb",
            //"args": ["-f", "~/thesis/test/write.s", "~/thesis/test/test.ddb"],
            "args": ["-f", "~/thesis/test/write.s", "$XNVME_DEV_USE"],
            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "environment": [],
            "externalConsole": false,
            "MIMode": "gdb", // Use "lldb" if on macOS
            "setupCommands": [
                {
                    "description": "Enable pretty-printing for gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}
